{
  "name": "apaar-garage-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "remove-admin": "node --env-file-if-exists=.env scripts/remove-admin.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "seed:images": "node scripts/generate-placeholder-images.js",
    "test": "node --test --test-concurrency=2 \"test/**/*.test.js\"",
    "lint": "eslint --max-warnings 0 src scripts test",
    "format": "prettier --write \"{src,scripts,test}/**/*.js\" eslint.config.mjs",
    "format:check": "prettier --check \"{src,scripts,test}/**/*.js\" eslint.config.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.0",
    "nodemailer": "^10.6.0",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "mongodb-memory-server-core": "^11.3.0",
    "prettier": "^3.10.1"
  }
}
