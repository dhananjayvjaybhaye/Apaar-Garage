NODE_ENV=development
MONGODB_URI="mongodb://127.0.0.1:27017/apaar-garage?replicaSet=rs0"
PORT=3000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Production forces 2FA. Uncomment to require enrollment during local testing.
# ADMIN_REQUIRE_2FA=true

# Optional document extraction for product prefill.
PRODUCT_AI_PREFILL=false
PRODUCT_AI_PREFILL_URL=
PRODUCT_AI_PREFILL_TOKEN=
# Optional dedicated persistent key as 64 hex characters. Otherwise derived from JWT_SECRET.
# ADMIN_TOTP_KEY=
# Product uploads use server/uploads in development when credentials are omitted.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Enable only behind a trusted loopback proxy that overwrites X-Forwarded-For.
# ADMIN_TRUST_LOOPBACK_PROXY=true
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
PAYMENT_ONLINE_ENABLED=false
# Snapshot on orders. Use your actual dispatching seller details before going live.
SELLER_NAME=""
SELLER_TRADE_NAME="Apaar Garage"
SELLER_STATE="Maharashtra"
SELLER_ADDRESS=""
GST_REGISTERED=false
SELLER_GSTIN=""
INVOICE_PREFIX=AG
CUSTOMER_CARE_PHONE=""
CUSTOMER_CARE_EMAIL=""
CUSTOMER_CARE_HOURS=""
GRIEVANCE_NAME=""
GRIEVANCE_DESIGNATION=""
GRIEVANCE_EMAIL=""
GRIEVANCE_PHONE=""
GRIEVANCE_ADDRESS=""
DEFAULT_RETURN_WINDOW_DAYS=7
# Checkout amounts are in rupees. Empty limits stay disabled.
COD_FEE=0
COD_MIN_ORDER_VALUE=0
COD_MAX_ORDER_VALUE=""
# Defaults for the first StoreSettings record. Use off for an optional limit.
COD_OPEN_PER_PHONE=2
COD_OPEN_PER_ADDRESS=3
COD_FIRST_ORDER_MAX=2500
COD_CONFIRM_ABOVE=4000
COD_UNDELIVERED_THRESHOLD=3
COD_UNDELIVERED_LOOKBACK_DAYS=90
COD_UNDELIVERED_ACTION=flag
# Use a stable random secret of at least 32 bytes for private keys and unsubscribe tokens.
# Leaving this blank falls back to JWT_SECRET.
BUSINESS_KEY_SECRET=""
# Days from order creation before anonymous order records can expire.
ORDER_RETENTION_DAYS=2555
ORDER_DELIVERY_ESTIMATE="A delivery estimate is pending order confirmation."
DELIVERY_FEE=0
FREE_DELIVERY_MIN_ORDER_VALUE=""
DELIVERY_PINCODE_RULES=[]
# Set this to 0 to disable the automatic first-order discount.
FIRST_ORDER_DISCOUNT_PERCENT=5
# Initial coupon records only. Codes use percent or amountPaise. Minimums are in paise.
# COUPONS_JSON=[{"code":"GARAGE10","percent":10,"minimumPaise":100000}]
COUPONS_JSON=[]
# Enable after entering your verified sender and Brevo SMTP credentials below.
ORDER_EMAIL_ENABLED=false
ORDER_EMAIL_FROM=orders@example.com
# Set to the public storefront HTTPS origin to include its logo in order emails.
ORDER_EMAIL_SITE_URL=
ORDER_SMTP_HOST=smtp-relay.brevo.com
ORDER_SMTP_PORT=587
ORDER_SMTP_USER=replace-with-smtp-user
ORDER_SMTP_PASSWORD=replace-with-smtp-password
